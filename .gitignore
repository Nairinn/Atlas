# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Kotlin / Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
*.class
.kotlin/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS
.DS_Store
Thumbs.db

# Node / Flutter (clients)
node_modules/
# Python byte-cache from the parity scripts.
__pycache__/
*.pyc

# Local env
.env
.env.local
*.local

# Per-developer Atlas project config (contains API key). Template is
# committed as atlas.toml.example; this file is per-machine.
atlas.toml

# Docker
atlas_pg_data/

# Logs
*.log

# Terraform
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.backup
infra/terraform/**/.terraform.lock.hcl
infra/terraform/**/*.tfvars
!infra/terraform/**/*.tfvars.example

# Generated protobuf code (each service regenerates from proto/)
**/generated/
**/gen/

# Dart SDK build output. `.dart_tool` is a local cache; `pubspec.lock` is
# deliberately NOT ignored for an application but IS for a library — a
# library that pins its own lockfile imposes those versions on nobody and
# only creates merge conflicts.
sdks/dart/.dart_tool/
sdks/dart/pubspec.lock
sdks/dart/build/
