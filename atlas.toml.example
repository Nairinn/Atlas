# Example atlas.toml.
# Copy to `atlas.toml` and replace the API key with one from your Atlas project.
# Validate with: `atlas validate`

[project]
name        = "my-mobility-app"
api_key     = "atl_live_xxxxxxxxxxxxxxxxxxxxxxxx"
environment = "production"        # development | staging | production
region      = "us-central1"       # us-central1 | eu-west1 | ap-southeast1

[services]
auth     = true
geo      = true
payments = true
events   = true

# The old [auth], [geo], [payments], and [events] tuning sections were
# removed: nothing on the platform ever read them, so validating them was
# config-shaped optimism. `atlas validate` warns if your file still has
# one; delete it at your leisure.
